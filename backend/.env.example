PORT=5000
MONGO_URI=mongodb://localhost:27017/smartq

JWT_ACCESS_SECRET=replace_with_secure_value
JWT_ACCESS_EXPIRES_IN=8h

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@example.com
SMTP_PASS=app_password
SMTP_FROM=SmartQ <you@example.com>
SMTP_ENABLE_FALLBACK=true
SMTP_TIMEOUT_MS=30000
# For many cloud hosts, STARTTLS works more reliably:
# SMTP_PORT=587
# SMTP_SECURE=false

ML_SERVICE_URL=http://localhost:5001

# Production (Render): set to your ML service URL, e.g.
# ML_SERVICE_URL=https://smartq-ml.onrender.com

# Comma-separated list of allowed frontend origins for API + Socket.IO.
# Production: include your Netlify URL, e.g.
# FRONTEND_ORIGINS=https://your-app.netlify.app,http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000
