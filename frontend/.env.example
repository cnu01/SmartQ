# Netlify / production build — set these in Netlify → Site configuration → Environment variables
# Use your Render backend URL (no trailing slash).

REACT_APP_API_URL=https://your-smartq-backend.onrender.com

# ML service (your live URL):
REACT_APP_ML_URL=https://smartq-ml-tbgh.onrender.com

# Fallback if Netlify env is missing at build: edit public/smartq-config.js (apiUrl = "...")

# Local development (copy to .env)
# REACT_APP_API_URL=http://localhost:5000
# REACT_APP_ML_URL=http://localhost:5001
